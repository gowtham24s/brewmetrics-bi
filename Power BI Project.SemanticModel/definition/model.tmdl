model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Fact_Sales","Dim_Date","Dim_City","Dim_Product","Dim_Store"]

annotation PBI_ProTooling = ["DevMode"]

ref table Fact_Sales
ref table Dim_Date
ref table Dim_City
ref table Dim_Product
ref table Dim_Store

ref cultureInfo en-IN

