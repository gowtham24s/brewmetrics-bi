          }
        ],
        "lineageTag": "8265ab56-441a-44d3-9f18-8a3727ce820e",
        "measures": [
          {
            "name": "Total Sales",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM(Fact_Sales[sales_amount])",
            "lineageTag": "fd256dd2-1c29-4e3d-9b45-bcf98233640e"
          },
          {
            "name": "MoM Growth %",
            "expression": [
              "",
              "VAR PreviousMonthSales =",
              "    CALCULATE(",
              "        [Total Sales],",
              "        DATEADD(Dim_Date[Date], -1, MONTH)",
              "    )",
              "RETURN",
              "    DIVIDE([Total Sales] - PreviousMonthSales, PreviousMonthSales)"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "58f64a6e-1137-4809-b0bb-3f8a17a862fb"
          },
          {
            "name": "Running Total Sales",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR CurrentDate = MAX(Dim_Date[Date])",
              "RETURN",
              "    CALCULATE(",
              "        [Total Sales],",
              "        FILTER(",
              "            ALL(Dim_Date[Date]),",
              "            Dim_Date[Date] <= CurrentDate",
              "        )",
              "    )"
            ],
            "lineageTag": "39b0756c-a622-4a74-bfe4-21704169c4cb"
          },
          {
            "name": "Item Rank",
            "expression": [
              "",
              "IF(",
              "    ISINSCOPE(Dim_Product[Item]),",
              "    RANKX(",
              "        ALLSELECTED(Dim_Product[Item]),",
              "        [Total Sales],",
              "        ,",
              "        DESC,",
              "        DENSE",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "c70413e4-a9ac-4418-b491-55e692312861"
          }
        ],
        "partitions": [
          {
            "name": "Fact_Sales",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\Downloads\\brewmetrics_sales.csv\"),[Delimiter=\",\", Columns=9, Encoding=1252, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"sale_id\", Int64.Type}, {\"date\", type date}, {\"city\", type text}, {\"store_format\", type text}, {\"category\", type text}, {\"item\", type text}, {\"quantity\", Int64.Type}, {\"unit_price\", Int64.Type}, {\"sales_amount\", type number}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
