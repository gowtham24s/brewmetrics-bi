        "dataCategory": "Time",
        "lineageTag": "a8660440-c77a-456b-9842-bb92aeacbb23",
        "partitions": [
          {
            "name": "Dim_Date",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Fact_Sales,",
                "    #\"Removed Other Columns\" = Table.SelectColumns(Source,{\"date\"}),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Removed Other Columns\"),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Removed Duplicates\",{{\"date\", \"Date\"}}),",
                "    #\"Inserted Year\" = Table.AddColumn(#\"Renamed Columns\", \"Year\", each Date.Year([Date]), Int64.Type),",
                "    #\"Inserted Month\" = Table.AddColumn(#\"Inserted Year\", \"Month\", each Date.Month([Date]), Int64.Type),",
                "    #\"Inserted Month Name\" = Table.AddColumn(#\"Inserted Month\", \"Month Name\", each Date.MonthName([Date]), type text),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Inserted Month Name\",{{\"Month\", \"Month Number\"}, {\"Month Name\", \"Month\"}}),",
                "    #\"Inserted Quarter\" = Table.AddColumn(#\"Renamed Columns1\", \"Quarter\", each Date.QuarterOfYear([Date]), Int64.Type)",
                "in",
                "    #\"Inserted Quarter\""
              ],
              "type": "m"
            }
          }
        ]
